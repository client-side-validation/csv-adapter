    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        echo ""
        echo "Network Options:"
        echo "  NETWORK=mainnet ./start.sh  (default)"
        echo "  NETWORK=testnet ./start.sh"
        exit 1
        ;;
